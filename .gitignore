# ==============================================================================
# Compiled Class Files & Build Outputs
# ==============================================================================
target/
build/
out/
bin/
dist/
*.class
*.war
*.nar
*.ear
*.jar
!**/wrapper/maven-wrapper.jar

# Compressed archives from manual backups
*.zip
*.tar.gz
*.rar
*.7z

