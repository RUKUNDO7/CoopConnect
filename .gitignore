.mvn/timing.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.flattened-pom.xml

# Gradle (in case Gradle wrapper/build is used)
.gradle/
gradle/
gradlew
gradlew.bat

